{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "app.config.ts", "expo-env.d.ts", "../../packages/*/src/**/*.ts", "../../packages/*/src/**/*.tsx", "../../features/*/src/**/*.tsx"]
}
