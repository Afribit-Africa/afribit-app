{
  "name": "afribit-os",
  "private": true,
  "license": "MIT",
  "description": "Afribit: one app for a self-custodial Bitcoin wallet, encrypted chat and community mesh internet.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "features/*",
    "modules/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/kernel --noEmit && tsc -p apps/shell --noEmit",
    "test": "vitest run",
    "admission": "vitest run tools/admission-check",
    "check": "npm run typecheck && npm run test",
    "postinstall": "node scripts/postinstall.mjs",
    "check:wallet": "npm run check -w @afribit/wallet-app"
  },
  "devDependencies": {
    "patch-package": "8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "expo-font": "~58.0.12",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "react-native-safe-area-context": "~5.11.1",
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    },
    "basic-ftp": ">=5.2.2",
    "bitcoinjs-lib": "^6.1.8",
    "cipher-base": "^1.0.6",
    "types-ramda": "0.29.4",
    "ejs": "3.1.9",
    "elliptic": "^6.6.1",
    "fast-xml-parser": "^5.3.5",
    "form-data": "^4.0.6",
    "pbkdf2": "^3.1.3",
    "sha.js": "^2.4.12",
    "shell-quote": "^1.11.0",
    "handlebars": ">=4.7.9",
    "protobufjs": ">=7.5.5",
    "@craftzdog/react-native-buffer": "6.1.2",
    "react-native-quick-base64": "3.0.2",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "3.3.0",
    "expo-router": {
      "@testing-library/react-native": "13.3.3"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
